{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ],
  "env": {
    "EMAIL_USER": "@EMAIL_USER",
    "EMAIL_PASSWORD": "@EMAIL_PASSWORD",
    "APP_URL": "@APP_URL",
    "SUPABASE_URL": "@SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY": "@SUPABASE_SERVICE_ROLE_KEY"
  }
}